import math

P = float(input("Enter Annual Contributions: $ "))
r = float(input("Enter Interest: % "))
t = float(input("Enter Time: year "))

r = (r / 100) + 1

def A(P, r, t):
    if r == 1:
        return P * 1 * t
        
    inside_parentheses = (r**t - 1 ) / (r - 1)
    return P * r * inside_parentheses
    
print(f'The Total Return is: $ {round(A(P, r, t), 2)}')
